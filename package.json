  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.72.2",
    "globals": "17.14.0",
    "happy-dom": "21.0.4"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.5"
