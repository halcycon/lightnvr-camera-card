    "vitest": "4.1.12",
    "@playwright/test": "1.56.1",
    "@types/node": "22.19.0",
    "eslint": "9.39.1",
    "@eslint/js": "9.39.1",
    "typescript-eslint": "8.72.2",
    "globals": "16.5.0",
    "happy-dom": "21.0.4"
  },
  "overrides": {
